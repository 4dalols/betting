generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  BET
  PAYOUT
  REFUND
  ADMIN_ADJUST
  LIQUIDITY
}

enum MarketType {
  BINARY
  MULTI
  FLIP
  LIQUID
}

enum MarketStatus {
  OPEN
  RESOLVED
  VOIDED
}

enum PaymentKind {
  DEPOSIT
  WITHDRAWAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  balanceCents  Int       @default(0)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  ledger          LedgerEntry[]
  bets            Bet[]
  marketsCreated  Market[]         @relation("MarketCreator")
  marketsResolved Market[]         @relation("MarketResolver")
  payments        PaymentRequest[] @relation("PaymentUser")
  paymentsHandled PaymentRequest[] @relation("PaymentHandler")
  comments        Comment[]
}

model LedgerEntry {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deltaCents Int
  type       LedgerType
  marketId   String?
  market     Market?    @relation(fields: [marketId], references: [id])
  note       String?
  reversed   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([userId, createdAt])
}

model Market {
  id                String       @id @default(cuid())
  question          String
  description       String?
  type              MarketType
  stakeCents        Int
  liquidityCents    Int?
  closesAt          DateTime?
  status            MarketStatus @default(OPEN)
  creatorId         String
  creator           User         @relation("MarketCreator", fields: [creatorId], references: [id])
  resolvedOutcomeId String?
  resolvedAt        DateTime?
  resolvedById      String?
  resolvedBy        User?        @relation("MarketResolver", fields: [resolvedById], references: [id])
  createdAt         DateTime     @default(now())

  outcomes Outcome[]
  bets     Bet[]
  ledger   LedgerEntry[]
  comments Comment[]

  @@index([status, closesAt])
}

model Comment {
  id        String   @id @default(cuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([marketId, createdAt])
}

model Outcome {
  id        String @id @default(cuid())
  marketId  String
  market    Market @relation(fields: [marketId], references: [id], onDelete: Cascade)
  label     String
  sortOrder Int
  shares    Float  @default(0)

  bets Bet[]
}

model Bet {
  id          String   @id @default(cuid())
  marketId    String
  market      Market   @relation(fields: [marketId], references: [id], onDelete: Cascade)
  outcomeId   String
  outcome     Outcome  @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents Int
  shares      Float    @default(0)
  createdAt   DateTime @default(now())

  @@unique([marketId, userId, outcomeId])
  @@index([userId])
}

model PaymentRequest {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation("PaymentUser", fields: [userId], references: [id])
  kind        PaymentKind
  amountCents Int
  method      String
  note        String?
  status      PaymentStatus @default(PENDING)
  handledById String?
  handledBy   User?         @relation("PaymentHandler", fields: [handledById], references: [id])
  handledAt   DateTime?
  createdAt   DateTime      @default(now())

  @@index([status, createdAt])
}

// Auth.js
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Price Is Right game (zero-knowledge group survey) ----------

enum GameStatus {
  LOBBY
  PLAYING
  FINISHED
}

enum ScoringMode {
  CLOSEST_WITHOUT_OVER
  CLOSEST
}

/// A survey question. Only aggregates are stored — never an individual's answer.
model Question {
  id        String   @id @default(cuid())
  prompt    String
  unit      String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  sum       Float    @default(0)
  answered  Int      @default(0)
  skipped   Int      @default(0)
  createdAt DateTime @default(now())

  rounds GameRound[]
}

model Game {
  id           String      @id @default(cuid())
  code         String      @unique
  status       GameStatus  @default(LOBBY)
  scoring      ScoringMode @default(CLOSEST_WITHOUT_OVER)
  hostToken    String      @unique
  currentRound Int         @default(0)
  createdAt    DateTime    @default(now())

  players GamePlayer[]
  rounds  GameRound[]
}

model GamePlayer {
  id       String   @id @default(cuid())
  gameId   String
  game     Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name     String
  token    String   @unique
  joinedAt DateTime @default(now())

  guesses Guess[]

  @@unique([gameId, name])
}

model GameRound {
  id         String    @id @default(cuid())
  gameId     String
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  questionId String
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)
  index      Int
  revealedAt DateTime?
  answerSum  Float?
  answered   Int?
  skipped    Int?

  guesses Guess[]

  @@unique([gameId, index])
}

model Guess {
  id        String     @id @default(cuid())
  roundId   String
  round     GameRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  playerId  String
  player    GamePlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  value     Float
  points    Int        @default(0)
  createdAt DateTime   @default(now())

  @@unique([roundId, playerId])
}

// ---------- Trade or Tighten ----------

enum TtPhase {
  AUCTION
  TIGHTEN
  QUOTE
  TRADE
  RESULTS
}

enum TtDistribution {
  SKEWED
  UNIFORM
}

enum TtSide {
  BUY
  SELL
  PASS
}

model TtGame {
  id        String     @id @default(cuid())
  code      String     @unique
  hostToken String     @unique
  status    GameStatus @default(LOBBY)
  createdAt DateTime   @default(now())

  // Settings
  distribution   TtDistribution @default(SKEWED)
  totalRounds    Int            @default(4)
  cardsPerRound  Int            @default(4)
  roomSize       Int            @default(4)
  cycles         Int            @default(2)
  tightenPct     Int            @default(10)
  auctionSecs    Int            @default(60)
  decisionSecs   Int            @default(15)
  tradeSecs      Int            @default(30)
  breakSecs      Int            @default(5)
  roundBreakSecs Int            @default(20)

  // Live state. Each room runs its own phase machine; the game only moves between rounds.
  currentRound     Int       @default(0)
  /// Set once every room in the current round has settled; the next round starts when it passes.
  roundBreakEndsAt DateTime?
  seq              Int       @default(0)

  players TtPlayer[]
  rooms   TtRoom[]
}

model TtPlayer {
  id       String   @id @default(cuid())
  gameId   String
  game     TtGame   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name     String
  token    String   @unique
  elo      Float    @default(1200)
  joinedAt DateTime @default(now())

  seats    TtSeat[]
  wonItems TtInfoItem[]
  bids     TtBid[]
  tightens TtTighten[]
  markets  TtMarket[]
  trades   TtTrade[]

  @@unique([gameId, name])
}

model TtRoom {
  id        String    @id @default(cuid())
  gameId    String
  game      TtGame    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  round     Int
  index     Int
  cards     Int[]
  phase     TtPhase   @default(AUCTION)
  cycle     Int       @default(0)
  /// Inputs for the current phase are accepted from opensAt (after the between-phase break) until endsAt.
  opensAt   DateTime  @default(now())
  endsAt    DateTime?
  seq       Int       @default(0)
  settledAt DateTime?

  seats    TtSeat[]
  items    TtInfoItem[]
  bids     TtBid[]
  tightens TtTighten[]
  markets  TtMarket[]
  trades   TtTrade[]

  @@unique([gameId, round, index])
}

/// A player's place in a room, plus their settled result for that round.
model TtSeat {
  id         String   @id @default(cuid())
  roomId     String
  room       TtRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId   String
  player     TtPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  eloBefore  Float
  tradingPnl Float?
  normalized Float?
  cost       Float?
  score      Float?
  eloAfter   Float?

  @@unique([roomId, playerId])
}

/// Info items in auction order: index 0 is the largest number.
model TtInfoItem {
  id       String    @id @default(cuid())
  roomId   String
  room     TtRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  index    Int
  value    Int
  winnerId String?
  winner   TtPlayer? @relation(fields: [winnerId], references: [id], onDelete: SetNull)
  price    Float?

  @@unique([roomId, index])
}

/// One sealed bid per item, submitted together: amounts[i] is the bid for info item i.
model TtBid {
  id        String   @id @default(cuid())
  roomId    String
  room      TtRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  playerId  String
  player    TtPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amounts   Float[]
  updatedAt DateTime @updatedAt

  @@unique([roomId, playerId])
}

/// A spread-width proposal; width null means "I'm out" (won't tighten further).
model TtTighten {
  id        String   @id @default(cuid())
  roomId    String
  room      TtRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cycle     Int
  playerId  String
  player    TtPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  width     Float?
  createdAt DateTime @default(now())

  @@index([roomId, cycle])
}

/// The market for a cycle: maker and width are fixed by the tighten phase, bid/ask by the maker's quote.
model TtMarket {
  id      String   @id @default(cuid())
  roomId  String
  room    TtRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cycle   Int
  makerId String
  maker   TtPlayer @relation(fields: [makerId], references: [id], onDelete: Cascade)
  width   Float
  bid     Float?
  ask     Float?
  /// The maker didn't quote in time, so the market was centered on the prior mean.
  auto    Boolean  @default(false)

  @@unique([roomId, cycle])
}

model TtTrade {
  id        String   @id @default(cuid())
  roomId    String
  room      TtRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  cycle     Int
  playerId  String
  player    TtPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  side      TtSide
  createdAt DateTime @default(now())

  @@unique([roomId, cycle, playerId])
}
