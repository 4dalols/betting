# Postgres connection string (Neon, Supabase, local docker, ...)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/betting"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google (and http://localhost:3000/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that get the ADMIN role on sign-in
ADMIN_EMAILS="you@gmail.com"
# Shown to users on the deposit form, e.g. "Zelle 555-123-4567" or "Venmo @you"
ADMIN_PAYMENT_HANDLE=""

# Local only: enables GET /api/dev-login?email=... to sign in without Google
DEV_LOGIN_ENABLED="false"
